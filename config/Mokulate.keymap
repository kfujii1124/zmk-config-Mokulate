#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W  &kp E  &kp R         &kp T             &kp TAB        &kp GRAVE      &kp Y     &kp U     &kp I      &kp O    &kp P
&mt LEFT_CONTROL A  &kp S  &kp D  &kp F         &kp G             &kp MINUS      &kp EQUAL      &kp H     &kp J     &kp K      &kp L    &kp P
&mt LEFT_SHIFT Z    &kp X  &kp C  &kp V         &kp B             &kp SEMI       &kp LS(COLON)  &kp N     &kp M     &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&lt 3 ESCAPE        &none  &none  &kp LEFT_ALT  &kp LEFT_COMMAND  &lt 2 SPACE    &lt 1 SPACE    &kp RGUI  &kp RALT  &none      &none    &lt 4 ESCAPE
            >;
        };

        NUMBER {
            bindings = <
&kp ESC           &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7    &kp N8    &kp N9  &kp N0     &trans
&kp LEFT_CONTROL  &none   &none   &none   &none   &none     &none   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none
&kp LEFT_SHIFT    &none   &none   &none   &none   &none     &none   &none     &none     &none   &none      &kp RSHFT
&trans            &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans  &trans     &trans
            >;
        };

        SYMBOL {
            bindings = <
&trans  &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)    &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &kp BSPC
&trans  &trans        &trans      &trans         &trans        &trans           &trans         &trans        &kp APOS      &kp LBKT      &kp RBKT      &kp BSLH
&trans  &trans        &trans      &trans         &trans        &trans           &trans         &trans        &trans        &trans        &kp SQT       &trans
&trans  &trans        &trans      &trans         &trans        &trans           &trans         &trans        &trans        &trans        &trans        &trans
            >;
        };

        CURSOR {
            bindings = <
&none  &none  &none  &kp N7  &kp N8  &kp N9    &none     &none     &none   &none      &none  &none
&none  &none  &none  &kp N4  &kp N5  &kp N6    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &none
&none  &none  &none  &kp N1  &kp N2  &kp N3    &none     &none     &none   &none      &none  &none
&none  &none  &none  &kp N0  &none   &none     &none     &none     &none   &none      &none  &none
            >;
        };

        BLUETOOTH {
            bindings = <
&none   &none   &none   &none   &none   &none     &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none   &none   &none   &none   &none   &none     &none   &none         &none         &none         &none         &bt BT_CLR
&none   &none   &none   &none   &none   &none     &none   &none         &none         &none         &none         &bt BT_CLR_ALL
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans        &none         &none         &none         &trans
            >;
        };
    };
};
